[debug] [2026-11-09T19:17:54.020Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-orlo:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n// Cada usuario solo lee y escribe su propio documento y sus subcolecciones. Nadie puede leer los\n// datos de otro usuario. El contenido de la app (estilos, lecciones, cuestionario) no esta en\n// Firestore: lo sirve el backend\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function esElDueno(userId) {\n      return request.auth != null && request.auth.uid == userId;\n    }\n\n    match /users/{userId} {\n      allow read, delete: if esElDueno(userId);\n      // El nombre es obligatorio y corto; nunca se guarda correo ni contrasena\n      allow create, update: if esElDueno(userId)\n        && request.resource.data.name is string\n        && request.resource.data.name.size() <= 40\n        && !('email' in request.resource.data)\n        && !('password' in request.resource.data);\n\n      match /results/{resultId} {\n        allow read, write: if esElDueno(userId);\n      }\n\n      match /lessonProgress/{lessonId} {\n        allow read, delete: if esElDueno(userId);\n        allow create, update: if esElDueno(userId)\n          && request.resource.data.status in ['sin_empezar', 'en_curso', 'completada'];\n      }\n\n      match /garments/{garmentId} {\n        allow read, delete: if esElDueno(userId);\n        allow create, update: if esElDueno(userId)\n          && request.resource.data.name is string\n          && request.resource.data.name.size() <= 40\n          && request.resource.data.category in ['arriba', 'abajo', 'abrigo', 'calzado', 'accesorio', 'otro'];\n      }\n\n      match /outfits/{outfitId} {\n        allow read, delete: if esElDueno(userId);\n        allow create, update: if esElDueno(userId)\n          && request.resource.data.name is string\n          && request.resource.data.name.size() <= 40\n          && request.resource.data.favorite is bool;\n      }\n\n      match /conversations/{conversationId} {\n        allow read, write: if esElDueno(userId);\n\n        match /messages/{messageId} {\n          allow read, delete: if esElDueno(userId);\n          allow create: if esElDueno(userId)\n            && request.resource.data.role in ['user', 'assistant'];\n        }\n      }\n    }\n  }\n}\n"}]}}
